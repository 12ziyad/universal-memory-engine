{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "uml-test",
	"main": "../src/index.js",
	"compatibility_date": "2026-06-23",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"secrets": { "required": [] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "uml-memory-test",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "../migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "EXPORTS",
			"bucket_name": "itsuki-exports-test"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "USER_MEMORY",
				"class_name": "UserMemory"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["UserMemory"]
		}
	],
	"vars": {
		"AI_ROUTING": "off",
		"AI_ROUTING_KILL": "0",
		"EVAL_MODE": "off",
		"USE_VECTORS": "false",
		"ENABLE_PASS2": "true",
		"RULES_PREVIEW_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
		"ITSUKI_MEMORY_V3": "on",
		"ITSUKI_MEMORY_V3_USERS": "",
		"ITSUKI_MEMORY_V3_EXTRACTION_B1": "off",
		"ITSUKI_MEMORY_V3_EXTRACTION_B1_USERS": "",
		"ITSUKI_MEMORY_V3_ATOMIC_CAPTURE": "on",
		"ITSUKI_MEMORY_V3_ATOMIC_CAPTURE_USERS": "",
		"ITSUKI_MEMORY_V3_ATOMIC_PROJECTION": "on",
		"ITSUKI_MEMORY_V3_ATOMIC_PROJECTION_USERS": "",
		"ITSUKI_MEMORY_V3_ATOMIC_COALESCING": "off",
		"ITSUKI_MEMORY_V3_ATOMIC_COALESCING_USERS": "",
		"ITSUKI_MEMORY_V3_HYBRID_RETRIEVAL": "on",
		"ITSUKI_MEMORY_V3_HYBRID_RETRIEVAL_USERS": "",
		"ITSUKI_MEMORY_V3_SOURCE_EXPANSION": "on",
		"ITSUKI_MEMORY_V3_SOURCE_EXPANSION_USERS": "",
		"ITSUKI_MEMORY_V3_EPISODE_FALLBACK": "off",
		"ITSUKI_MEMORY_V3_EPISODE_FALLBACK_USERS": "",
		"ITSUKI_MEMORY_V3_ADAPTIVE_CONTEXT": "off",
		"ITSUKI_MEMORY_V3_ADAPTIVE_CONTEXT_USERS": "",
		"SAFE_MEMORY_UPDATES": "on",
		"CONVERSATION_PAGES": "on",
		"MCP_OAUTH": "on"
	}
}
