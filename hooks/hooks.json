{
	"description": "Itsuki memory hooks: deliver protected local outbox entries and recall project memory at session start; queue the session locally at session end. Neither hook may break the agent session.",
	"hooks": {
		"UserPromptExpansion": [
			{
				"matcher": "^(?:doctor|itsuki:doctor)$",
				"hooks": [
					{
						"type": "command",
						"command": "${user_config.node_executable}",
						"args": [
							"${CLAUDE_PLUGIN_ROOT}/hooks/doctor-hook.mjs",
							"--plugin-data",
							"${CLAUDE_PLUGIN_DATA}"
						],
						"timeout": 30
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${user_config.node_executable}",
						"args": [
							"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs",
							"--plugin-data",
							"${CLAUDE_PLUGIN_DATA}"
						],
						"timeout": 15
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${user_config.node_executable}",
						"args": [
							"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.mjs",
							"--plugin-data",
							"${CLAUDE_PLUGIN_DATA}"
						]
					}
				]
			}
		]
	}
}
