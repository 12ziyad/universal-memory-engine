/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "uml",
	"main": "src/index.js",
	"compatibility_date": "2026-06-23",
	// The canonical home. workers.dev stays enabled deliberately: MCP links on
	// the old host are pasted into people's clients and must keep resolving.
	"routes": [
		{ "pattern": "itsuki.app", "custom_domain": true }
	],
	"workers_dev": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// HTML paths run through the worker so the legacy host can 301 them to
		// itsuki.app. Everything else (fonts, /assets/*) is served straight from
		// the edge as before. /v1/* and /mcp/* are never redirected — not every
		// client follows redirects, so both hosts serve them natively.
		"run_worker_first": ["/", "/docs", "/docs/*"]
	},
	"observability": {
		"enabled": true
	},
	// The reconciliation sweep (fix round 1): every 5 minutes, rescue stale
	// jobs, alert on failures, and assert accepted-in == jobs-tracked. It is
	// deliberately a Cron Trigger — independent of the DO alarms it audits.
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "uml-memory",
			"database_id": "3202df08-e568-4e53-a8cd-a85630db50f8",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "USER_MEMORY",
				"class_name": "UserMemory"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"UserMemory"
			]
		}
	],
	"ai": {
		"binding": "AI",
		// AI always runs against Cloudflare, deploy or local dev. Saying so
		// explicitly is what lets `wrangler dev` reach the real models (and
		// silences the "may incur usage charges in local dev" warning).
		"remote": true
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "uml-node-embeddings"
		}
	],
	"vars": {
		"USE_VECTORS": "true",
		"ENABLE_PASS2": "true",
		"LLM_PROVIDER": "workers-ai",
		// Extraction model (Priority 2 bake-off winner): Qwen3-30B-A3B — top accuracy,
		// reliable JSON, ~6s avg / ~7s max (well under the live budget), and far more
		// robust on messy/ambiguous input than the 8B. One-line switch.
		"LLM_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
		// Qwen was returning valid-looking JSON cut off mid-object in production
		// without an explicit output budget. Keep enough room for multi-message
		// manual saves and poisoned-chunk retries.
		"LLM_MAX_TOKENS": "4096",
		// Cheap model kept for Pass-2 summaries + the save_conversation digest.
		"LLM_SUMMARY_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
		"LLM_SUMMARY_MAX_TOKENS": "256",
		"LLM_DIGEST_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
		"LLM_DIGEST_MAX_TOKENS": "768",
		"EMBED_MODEL": "@cf/baai/bge-base-en-v1.5",
		// The Playground's conversational model. Deliberately SEPARATE from
		// LLM_MODEL: that one is tuned for extraction and swapping it would
		// change what the product captures. This is the smallest instruct model
		// in the Workers AI catalogue, which is exactly right — its only job is
		// to reply conversationally so the extractor has something to work with.
		"CHAT_MODEL": "@cf/meta/llama-3.2-1b-instruct",
		// Split-rescue guardrails: a failed primary parse may re-extract at most
		// this many messages individually (past it the fire fails cleanly), and
		// abandons after this many per-message parse failures. The 107-call,
		// zero-write fires these dials exist for are in the conv-0 smoke notes.
		"SPLIT_RESCUE_MAX_CALLS": "8",
		"SPLIT_RESCUE_FAIL_FAST": "3",
		// A public playground with a free model call per turn is a free LLM for
		// anyone who signs up. Per user, per UTC day.
		"PLAYGROUND_DAILY_MESSAGES": "30",
		"PLAYGROUND_MAX_THREADS": "5",
		// OAuth client id is public by design; the secret lives in a Worker secret.
		"GOOGLE_CLIENT_ID": "422154363135-ssr4h8vpegdg54h5219bcldphe5s87q9.apps.googleusercontent.com",
		// Memory V3, enabled for BENCHMARK TENANTS ONLY (campaign §10). Every real
		// account stays on the proven legacy path: `allowlist` mode enables exactly
		// the ids named below and nothing else, and the resolver takes (env, userId)
		// only, so no caller can opt themselves in. Verify on GET /health — it
		// reports the mode and the COUNT, never the ids.
		//
		// These scoped campaign tenants hold synthetic benchmark/holdout data and
		// are deleted at their registered cleanup boundaries (see cleanup-ledger.md).
		"ITSUKI_MEMORY_V3": "allowlist",
		"ITSUKI_MEMORY_V3_USERS": "mem_119e35f60838133e8b7f13f21bd07c01,mem_fcf7b96a90d7d84b89fe72562fb4aad0,mem_509271a5821597a9fc0b906e3cb53c0f,mem_2488d2eb264fe82a44078f9997051a48,mem_8e70b85407733111f9d58a26ae8e3dc8,mem_805e90584cff69885339d43eee178726,mem_abdb39d1a6f74328f214a126f73bbce2,mem_0a52a54229833f63cabf5910f807e6ab,mem_d5b5b605df9fe83e5fe41ecfa8c5d8bd,mem_7720821d8d2fc415cd0fe5d45f59c115,mem_9aeab16f8cce280442aace457350fc0a,mem_bcd603957eee05670624f1f83799de77,mem_a9d7da1016228c247fd0c0d53e09e305,mem_d6383f03521fedb0f4c3534acebbaf97,mem_2dafc133073f1efbf11dccc863ac4172,mem_e49de774bc9c6223be57c1c02d6a2899,mem_c9580038e819c236fd79976c06fbcab2,mem_563bbd5d1c51bcfa0f17a6a9c1350522,mem_5ff293413716d89601acfbacf6f481b9,mem_1363a603ee5b54364dd508b9bb98c528,mem_0e31646bbc5e929fd410f2c77d4c9e30,mem_509f5cea063ca216bea17f4ccdb0fcc1,mem_b4d8a0b4f938d13392187022aedd3421,mem_8866073597edbb24c8c4bf6118363f54,mem_5e14d5e51b4db6ebdb8ce4dad6bd7aed,mem_98597b3f4ec03d05348d606b471dbecf,mem_c7fb389dc7153489990ac3bb2c87bf57,mem_ef73d3bde23303be216373b3953bbcfe,mem_8418fc674eb7d8d69ffd1c3e7ac58fd2,mem_31988a00ba0b73f26df882ee3d1598dc",
		"ITSUKI_MEMORY_V3_EXTRACTION_B1": "off",
		// Final Stage D is complete and its synthetic treatment slots are clean.
		// Accepted write/source lanes return OFF between validation stages; E7
		// remains only on the historical d04 cohort. Rejected features remain OFF.
		"ITSUKI_MEMORY_V3_ATOMIC_CAPTURE": "off",
		"ITSUKI_MEMORY_V3_ATOMIC_CAPTURE_USERS": "",
		"ITSUKI_MEMORY_V3_ATOMIC_PROJECTION": "off",
		"ITSUKI_MEMORY_V3_ATOMIC_PROJECTION_USERS": "",
		"ITSUKI_MEMORY_V3_ATOMIC_COALESCING": "off",
		"ITSUKI_MEMORY_V3_ATOMIC_COALESCING_USERS": "",
		"ITSUKI_MEMORY_V3_HYBRID_RETRIEVAL": "allowlist",
		"ITSUKI_MEMORY_V3_HYBRID_RETRIEVAL_USERS": "mem_119e35f60838133e8b7f13f21bd07c01,mem_fcf7b96a90d7d84b89fe72562fb4aad0,mem_509271a5821597a9fc0b906e3cb53c0f,mem_2488d2eb264fe82a44078f9997051a48,mem_8e70b85407733111f9d58a26ae8e3dc8,mem_805e90584cff69885339d43eee178726,mem_abdb39d1a6f74328f214a126f73bbce2,mem_0a52a54229833f63cabf5910f807e6ab,mem_d5b5b605df9fe83e5fe41ecfa8c5d8bd,mem_7720821d8d2fc415cd0fe5d45f59c115",
		"ITSUKI_MEMORY_V3_SOURCE_EXPANSION": "off",
		"ITSUKI_MEMORY_V3_SOURCE_EXPANSION_USERS": "",
		"ITSUKI_MEMORY_V3_EPISODE_FALLBACK": "off",
		"ITSUKI_MEMORY_V3_EPISODE_FALLBACK_USERS": "",
		"ITSUKI_MEMORY_V3_ADAPTIVE_CONTEXT": "off",
		"ITSUKI_MEMORY_V3_ADAPTIVE_CONTEXT_USERS": ""
		// NOTE: EVAL_MODE stays OUT of production. Set it here only for the
		// duration of a benchmark run (it enables the /eval/llm pass-through in
		// src/index.js), then remove it and redeploy.
	},
	// Workers rate limiting (fails open in code when a binding is absent).
	// AUTH_LIMITER: per-IP on login/signup/OAuth. SAVE_LIMITER: per-user on saves.
	"unsafe": {
		"bindings": [
			{ "name": "AUTH_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
			{ "name": "SAVE_LIMITER", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
			{ "name": "RECALL_LIMITER", "type": "ratelimit", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
		]
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
