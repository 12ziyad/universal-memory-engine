/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "uml",
	"main": "src/index.js",
	"compatibility_date": "2026-06-23",
	// The canonical home. workers.dev stays enabled deliberately: MCP links on
	// the old host are pasted into people's clients and must keep resolving.
	"routes": [
		{ "pattern": "itsuki.app", "custom_domain": true }
	],
	"workers_dev": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// HTML paths run through the worker so the legacy host can 301 them to
		// itsuki.app. Everything else (fonts, /assets/*) is served straight from
		// the edge as before. /v1/* and /mcp/* are never redirected — not every
		// client follows redirects, so both hosts serve them natively.
		// /.well-known/* and /oauth/* are Worker-owned: OAuth discovery and the
		// consent flow must never be shadowed by a static file that happens to
		// share the path.
		"run_worker_first": ["/", "/docs", "/docs/*", "/.well-known/*", "/oauth/*"]
	},
	"observability": {
		"enabled": true
	},
	// The reconciliation sweep (fix round 1): every 5 minutes, rescue stale
	// jobs, alert on failures, and assert accepted-in == jobs-tracked. It is
	// deliberately a Cron Trigger — independent of the DO alarms it audits.
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "uml-memory",
			"database_id": "3202df08-e568-4e53-a8cd-a85630db50f8",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "USER_MEMORY",
				"class_name": "UserMemory"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"UserMemory"
			]
		}
	],
	"ai": {
		"binding": "AI",
		// AI always runs against Cloudflare, deploy or local dev. Saying so
		// explicitly is what lets `wrangler dev` reach the real models (and
		// silences the "may incur usage charges in local dev" warning).
		"remote": true
	},
	// Transactional mail only: member invitations and passwordless sign-in
	// codes, both rendered by src/lib/email_template.js. The binding is
	// restricted to Itsuki's dedicated sending identity so application code
	// cannot become an open relay. Local tests omit this binding and use a
	// deterministic fake.
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["invites@notify.itsuki.app"]
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "uml-node-embeddings"
		}
	],
	"vars": {
		"USE_VECTORS": "true",
		"ENABLE_PASS2": "true",
		"LLM_PROVIDER": "workers-ai",
		// Extraction model (Priority 2 bake-off winner): Qwen3-30B-A3B — top accuracy,
		// reliable JSON, ~6s avg / ~7s max (well under the live budget), and far more
		// robust on messy/ambiguous input than the 8B. One-line switch.
		"LLM_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
		// Qwen was returning valid-looking JSON cut off mid-object in production
		// without an explicit output budget. Keep enough room for multi-message
		// manual saves and poisoned-chunk retries.
		"LLM_MAX_TOKENS": "4096",
		// Cheap model kept for Pass-2 summaries + the save_conversation digest.
		"LLM_SUMMARY_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
		"LLM_SUMMARY_MAX_TOKENS": "256",
		"LLM_DIGEST_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
		"LLM_DIGEST_MAX_TOKENS": "768",
		"EMBED_MODEL": "@cf/baai/bge-base-en-v1.5",
		// The Playground's conversational model. Deliberately SEPARATE from
		// LLM_MODEL: that one is tuned for extraction and swapping it would
		// change what the product captures. This is the smallest instruct model
		// in the Workers AI catalogue, which is exactly right — its only job is
		// to reply conversationally so the extractor has something to work with.
		"CHAT_MODEL": "@cf/meta/llama-3.2-1b-instruct",
		// Split-rescue guardrails: a failed primary parse may re-extract at most
		// this many messages individually (past it the fire fails cleanly), and
		// abandons after this many per-message parse failures. The 107-call,
		// zero-write fires these dials exist for are in the conv-0 smoke notes.
		"SPLIT_RESCUE_MAX_CALLS": "8",
		"SPLIT_RESCUE_FAIL_FAST": "3",
		// A public playground with a free model call per turn is a free LLM for
		// anyone who signs up. Per user, per UTC day.
		"PLAYGROUND_DAILY_MESSAGES": "30",
		"PLAYGROUND_MAX_THREADS": "5",
		"PUBLIC_ORIGIN": "https://itsuki.app",
		"INVITE_EMAIL_FROM": "invites@notify.itsuki.app",
		"RULES_PREVIEW_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
		// OAuth client ids are public by design; secrets live in Worker secrets.
		"GOOGLE_CLIENT_ID": "422154363135-ssr4h8vpegdg54h5219bcldphe5s87q9.apps.googleusercontent.com",
		"GITHUB_CLIENT_ID": "Ov23liYMcaD6aJZSkWgc",
		// Memory V3 public beta. The owner explicitly authorized the validated V3
		// architecture for every account while expected traffic is still 5–10 early
		// users. The resolver remains account-bound and the previous Worker version
		// is the immediate behavioural rollback. GET /health exposes modes only.
		"ITSUKI_MEMORY_V3": "on",
		"ITSUKI_MEMORY_V3_USERS": "",
		"ITSUKI_MEMORY_V3_EXTRACTION_B1": "off",
		// Exact Stage E winner: source episodes + atomic capture/projection + E7
		// hybrid retrieval + E9A exact source expansion. Rejected B1, coalescing,
		// episode fallback and adaptive-context treatments remain OFF.
		"ITSUKI_MEMORY_V3_ATOMIC_CAPTURE": "on",
		"ITSUKI_MEMORY_V3_ATOMIC_CAPTURE_USERS": "",
		"ITSUKI_MEMORY_V3_ATOMIC_PROJECTION": "on",
		"ITSUKI_MEMORY_V3_ATOMIC_PROJECTION_USERS": "",
		"ITSUKI_MEMORY_V3_ATOMIC_COALESCING": "off",
		"ITSUKI_MEMORY_V3_ATOMIC_COALESCING_USERS": "",
		"ITSUKI_MEMORY_V3_HYBRID_RETRIEVAL": "on",
		"ITSUKI_MEMORY_V3_HYBRID_RETRIEVAL_USERS": "",
		"ITSUKI_MEMORY_V3_SOURCE_EXPANSION": "on",
		"ITSUKI_MEMORY_V3_SOURCE_EXPANSION_USERS": "",
		"ITSUKI_MEMORY_V3_EPISODE_FALLBACK": "off",
		"ITSUKI_MEMORY_V3_EPISODE_FALLBACK_USERS": "",
		"ITSUKI_MEMORY_V3_ADAPTIVE_CONTEXT": "off",
		"ITSUKI_MEMORY_V3_ADAPTIVE_CONTEXT_USERS": "",
		// The AI budget: one launch plan for everyone, per-user overrides in
		// user_entitlements (migration 0059). MONTHLY_WRITES is the
		// per-account calendar-month cap on AI-processed saves (exact, counted
		// in D1). DAILY_NEURONS_PER_USER is the per-user daily allowance
		// (~100 saves at the measured ~150 neurons/save), reset 00:00 UTC.
		// DAILY_NEURON_CEILING is the account-wide circuit breaker — the
		// wallet backstop, since Workers AI has no hard spend cap. Raised to
		// 1.5M so 100 users at the full per-user allowance (100 × 15,000 =
		// 1.5M) is the collision point rather than 50 — the per-user cap and
		// the global breaker must not meet at exactly the planned headcount.
		"AI_MONTHLY_WRITES": "1000",
		"AI_DAILY_NEURON_CEILING": "1500000",
		"AI_DAILY_NEURONS_PER_USER": "15000",
		// Huba AI: the grounded product assistant. Same account, same meter
		// (scope huba_chat), its own message allowance. The model is the
		// proven extraction MoE — high instruction-following for the
		// grounding/refusal contract at ~3B active parameters of cost.
		// Chosen by measurement, not by parameter count. Benchmarked against
		// the current qwen3-30b (3B active), llama-3.3-70b and nemotron-120b on
		// fifteen real questions with known-true answers: qwen scored 2/5 and
		// returned EMPTY content on one (reasoning exhausted the token budget),
		// llama got the arithmetic wrong, nemotron hallucinated an npm package
		// that does not exist. gpt-oss-120b scored 4.5/5 — right package, right
		// arithmetic, working shown — at ~147 neurons against qwen's ~33.
		// Affordable because huba_chat no longer draws on the save allowance.
		"HUBA_MODEL": "@cf/openai/gpt-oss-120b",
		// Headroom: a reasoning model that runs out mid-thought returns null
		// content, which is exactly how the previous model failed.
		"HUBA_MAX_TOKENS": "1400",
		"HUBA_FIRST_DAY_MESSAGES": "50",
		"HUBA_DAILY_MESSAGES": "20",
		// Upgrade-request notifications (usage page "Request more" → owner).
		"OWNER_NOTIFY_EMAIL": "kayotenetwork@gmail.com",
		// Safe memory updates staged rollout. "track": schema + revision
		// tracking live, public update/history/rollback doors disabled
		// (Stage A). "on": doors enabled (Stage B). Stage B's rollback target
		// is this same tree with "track" — the version trackers keep running
		// under rollback, so no unversioned-mutation window can open.
		"SAFE_MEMORY_UPDATES": "on",
		// Conversation Pages staged rollout. "track": schema + per-page source
		// links live, behavior unchanged (one page per accepted MCP batch, no
		// REST pages, no identity convergence). "on": deterministic
		// conversation identity — one live page per (account, project,
		// conversation), REST /v1/save mode:"conversation" creates/advances
		// pages, graph_only suppresses them. Rollback is the flag flip.
		"CONVERSATION_PAGES": "on",
		// MCP OAuth 2.1 staged rollout. "track": the schema and code are
		// deployed but every /oauth/* and OAuth metadata path answers 404 and
		// no grant can be issued — an authorization server that cannot finish
		// the flow must not be discoverable. "on": the full flow. Rollback is
		// the flag flip; the previous Worker version is the hard rollback.
		"MCP_OAUTH": "on",
		// AI provider routing master gate. "off" (default): ordinary UNPINNED
		// work never consults policy — zero routing D1 reads and Workers AI only.
		// It deliberately does not rewrite an already-durable provider pin or
		// suppress an explicit admin health probe. "track": policy read + recorded,
		// execution still Workers AI. "on": per-lane policy takes effect, but every
		// Google route still requires a syntactically valid, non-empty account
		// allowlist and exact server-owned account membership. Emergency levers:
		// admin emergency-disable stops new policy admission (D1, ≤60s); only
		// AI_ROUTING_KILL="1" hard-stops non-default admission for pins and health
		// probes too. The previous Worker version is the final code rollback. Google
		// also requires the GCP_SERVICE_ACCOUNT secret and GCP_PROJECT_ID var.
		"AI_ROUTING": "off",
		// Maintenance switch. "on": non-admin API/MCP/OAuth answer 503 with a
		// Retry-After while the landing page, docs, legal pages, .well-known
		// and the auth doors keep serving; admin sessions pass everything.
		// An env var, not D1, on purpose: zero hot-path cost, flipping it
		// requires Cloudflare-account trust, and it works when D1 is down.
		// Rollback is the flag flip (edit + redeploy).
		"MAINTENANCE_MODE": "off"
		// NOTE: EVAL_MODE stays OUT of production. Set it here only for the
		// duration of a benchmark run (it enables the /eval/llm pass-through in
		// src/index.js), then remove it and redeploy.
	},
	// Workers rate limiting (fails open in code when a binding is absent).
	// AUTH_LIMITER: per-IP on login/signup/OAuth. SAVE_LIMITER: per-user on saves.
	"unsafe": {
		"bindings": [
			{ "name": "AUTH_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
			{ "name": "SAVE_LIMITER", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
			{ "name": "RECALL_LIMITER", "type": "ratelimit", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
			// Destructive work gets a tighter bucket than ordinary writes: a loop
			// that deletes is worse than a loop that saves.
			{ "name": "DELETE_LIMITER", "type": "ratelimit", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
			// Bulk import (workspace files, backfills) is legitimate burst traffic.
			// It gets headroom here because monthly AI budget — not this limiter —
			// is what actually bounds spend.
			{ "name": "IMPORT_LIMITER", "type": "ratelimit", "namespace_id": "1005", "simple": { "limit": 300, "period": 60 } },
			// Read-side protection for the inventory routes. Reads cost D1 rows,
			// not inference, so this is deliberately loose.
			{ "name": "READ_LIMITER", "type": "ratelimit", "namespace_id": "1006", "simple": { "limit": 240, "period": 60 } }
		]
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
